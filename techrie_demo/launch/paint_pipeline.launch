<launch>
  <!-- 手動で /system/started=True にする運用は現状維持 -->

  <!-- 震え対策を入れたジッタ再生 -->
  <node pkg="techrie_demo" type="traj_jitter_player.py" name="traj_jitter_player" output="screen">
    <param name="motion_dir" value="$(find techrie_demo)/motions"/>
    <param name="out_subdir" value="_jit"/>
    <param name="pos_sigma_rad" value="0.01"/>
    <param name="pos_clip_rad" value="0.03"/>
    <param name="t_sigma_sec" value="0.0"/>
    <param name="min_dt" value="0.04"/>
    <param name="reverse_prob" value="0.0"/>
    <param name="insert_hold_prob" value="0.0"/>
    <param name="hold_dur_sec" value="0.06"/>
  </node>

  <!-- フロー管理（ASCIIセーフにしておく：警告を回避） -->
  <node pkg="techrie_demo" type="paint_executor.py" name="paint_executor" output="screen" />

</launch>
