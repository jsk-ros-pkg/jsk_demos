<launch>

  <arg name="namespace" default="robot_a" />
  <arg name="model_path" default="$(find stereo_image_sandbox)/models/keypoint_classifier.tflite" />
  <arg name="label_csv" default="$(find stereo_image_sandbox)/models/keypoint_classifier_label.csv" />

  <group if="$(eval len(arg('namespace')) > 0)" ns="$(arg namespace)" >
    <node name="gesture_recognition"
          pkg="stereo_image_sandbox" type="gesture_recognition.py"
          output="screen" >
      <env name="LD_PRELOAD" value="/usr/lib/aarch64-linux-gnu/libGLdispatch.so.0" />
      <remap from="~input" to="/$(arg namespace)/camera/color/image_raw" />
      <rosparam subst_value="true">
        model_path: $(arg model_path)
        label_csv: $(arg label_csv)
      </rosparam>
    </node>
  </group>

  <group unless="$(eval len(arg('namespace')) > 0)">
    <node name="gesture_recognition"
          pkg="stereo_image_sandbox" type="gesture_recognition.py"
          output="screen" >
      <env name="LD_PRELOAD" value="/usr/lib/aarch64-linux-gnu/libGLdispatch.so.0" />
      <remap from="~input" to="/camera/color/image_raw" />
      <rosparam subst_value="true">
        model_path: $(arg model_path)
        label_csv: $(arg label_csv)
      </rosparam>
    </node>
  </group>

</launch>
