<launch>

  <node name="master_discovery"
        pkg="fkie_master_discovery" type="master_discovery"
        output="screen" >
  </node>

  <node name="master_sync"
        pkg="fkie_master_sync" type="master_sync"
        output="screen" >
  </node>

  <node name="param_sync"
        pkg="fkie_master_sync" type="param_sync.py"
        output="screen" >
    <rosparam>
      add_ns: false
    </rosparam>
  </node>

</launch>
