<launch>
  <!-- RealSense RGBD camera -->
  <include file="$(find realsense2_camera)/launch/rs_rgbd.launch" />

  <!-- voicevox with docker -->
  <include file="$(find voicevox)/launch/voicevox_texttospeech.launch">
    <arg name="use_docker" value="true"/>
    <arg name="host" value="20.243.205.82"/>
  </include>

  <!-- QR code reader -->
  <node pkg="jsk_2025_05_kashiwagi" type="qr_code_reader.py" name="qr_code_reader" output="screen" />
  <!-- QR code depth reader -->
  <node pkg="jsk_2025_05_kashiwagi" type="qr_code_depth_reader.py" name="qr_code_depth_reader" output="screen" />
  
  <!-- response generator  -->
  <node pkg="jsk_2025_05_kashiwagi" type="response_generator.py" name="question_generator" output="screen" />

  <!-- response speaker -->
  <node pkg="jsk_2025_05_kashiwagi" type="response_speaker.py" name="response_speaker" output="screen" />

  <!-- state manager -->
  <node pkg="jsk_2025_05_kashiwagi" type="kashiwagi_state_manager.py" name="kashiwagi_state_manager" output="screen" />

  <!-- motion manager -->
  <node pkg="jsk_2025_05_kashiwagi" type="kashiwagi_motion_manager.py" name="kashiwagi_motion_manager" output="screen" />

  <!-- led ume manager -->
  <node pkg="jsk_2025_05_kashiwagi" type="kashiwagi_led_manager.py" name="kashiwagi_led_manager" output="screen" />
</launch>
