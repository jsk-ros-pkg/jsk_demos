<launch>

  <arg name="raw_audio_topic" default="/audio" doc="Name of audio topic captured from respeaker." />
  <arg name="dummy_audio_topic" default="/dummy_audio" doc="Dummy audio. no Audio" />
  <arg name="audio_topic" default="/input_audio" doc="Selected audio topic" />
  <arg name="audio_info_topic" default="/audio_info" doc="Selected audio info topic" />  
  <arg name="language" default="ja-JP"/>
  <arg name="self_cancellation" default="false"/>  

  <!-- respeaker -->
  <node name="respeaker_node"
	pkg="respeaker_ros" type="respeaker_node.py"
        respawn="true" respawn_delay="10" >
    <rosparam>
      sample_duration: 0.03
    </rosparam>
  </node>

  <node name="webrtcvad_ros"
        pkg="webrtcvad_ros" type="webrtcvad_ros.py"
        output="screen" >
    <rosparam>
      aggressiveness: 1
    </rosparam>
    <remap from="audio_data" to="$(arg audio_topic)" />
    <remap from="audio_info" to="$(arg audio_info_topic)" />
  </node>
  
  <node name="speech_to_text" pkg="respeaker_ros" type="speech_to_text.py"
        output="screen">
    <remap from="audio" to="webrtcvad_ros/speech_audio"  />    
    <rosparam subst_value="true">
      language: $(arg language)
      self_cancellation: $(arg self_cancellation)
      tts_tolerance: 0.5
    </rosparam>
  </node>
  
  <!-- voicevox with docker -->
  <include file="$(find voicevox)/launch/voicevox_texttospeech.launch">
    <arg name="use_docker" value="true"/>
    <arg name="host" value="20.243.128.11"/>
    <!-- <arg name="device" value="plughw:2,0"/> -->
    <arg name="device" value="uac_demo"/>
  </include>

  <node name="is_speaking"
        pkg="sound_play" type="is_speaking.py" >
    <remap from="~robotsound" to="/robotsound_jp/status" />
    <remap from="~output/is_speaking" to="is_speaking" />
  </node>

  <node name="input_audio_mux"
  	pkg="topic_tools" type="mux"
        respawn="true"
	args="$(arg audio_topic) $(arg raw_audio_topic) $(arg dummy_audio_topic)">
    <remap from="mux" to="input_audio_mux" />
  </node>

  <node name="input_audio_selector"
	pkg="riberry_startup" type="mux_selector.py"
	respawn="true"
	args="/is_speaking 'm.data is False' $(arg raw_audio_topic) /is_speaking 'm.data is True' $(arg dummy_audio_topic)">
    <remap from="mux" to="input_audio_mux" />
    <param name="default_select" value="$(arg dummy_audio_topic)" />
    <param name="wait" value="true" />
  </node>

  <!--listener -->
  <node pkg="jsk_2025_05_kashiwagi" type="kashiwagi_listener_2.py" name="kashiwagi_listener" output="screen" />

</launch>
