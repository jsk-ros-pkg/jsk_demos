#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import json
import argparse
import os
import requests
import hashlib
import shutil


def get_cache_dir():
    """Return cache dir."""
    ros_home = os.getenv('ROS_HOME', os.path.expanduser('~/.ros'))
    pkg_ros_home = os.path.join(ros_home, 'edge')
    default_cache_dir = os.path.join(pkg_ros_home, 'cache')
    cache_dir = os.environ.get('ROS_GOOGLE_TEXTTOSPEECH_CACHE_DIR', default_cache_dir)
    if not os.path.exists(cache_dir):
        os.makedirs(cache_dir)
    return cache_dir

def checksum_md5(filename, blocksize=8192):
    """Calculate md5sum."""
    hash_factory = hashlib.md5()
    with open(filename, 'rb') as f:
        for chunk in iter(lambda: f.read(blocksize), b''):
            hash_factory.update(chunk)
    return hash_factory.hexdigest()

if __name__ == '__main__':
    parser = argparse.ArgumentParser(description='Send text to FastAPI server for speech synthesis.')
    parser.add_argument('-eval', '--evaluate', help='Language evaluation', default='(en)')
    parser.add_argument('-o', '--output', help='Output wav file path', required=True)
    parser.add_argument('text', help='Input text file path')
    args = parser.parse_args()

    with open(args.text, 'r') as f:
        speech_text = f.read()

    lang = args.evaluate.strip('()')
    if lang not in ['ja', 'en']:
        lang = 'en'

    cache_enabled = True
    if cache_enabled:
        cache_dir = get_cache_dir()
        md5 = checksum_md5(args.text)
        cache_filename = os.path.join(cache_dir, f'{md5}--{lang}.wav')
        if os.path.exists(cache_filename):
            print(f'[Text2Wave] Using cached sound file ({cache_filename}) for {speech_text}')
            shutil.copy(cache_filename, args.output)
        else:
            server_url = "http://127.0.0.1:8000/text-to-speech/"
            headers = {'Content-Type': 'application/json'}
            payload = json.dumps({
                'text': speech_text,
                'lang': lang,
                'output_path': args.output,
            })

            response = requests.post(
                server_url, data=payload,
                headers=headers)
            if response.status_code == 200:
                with open(args.output, 'wb') as f:
                    f.write(response.content)
                print(f'[Text2Wave] Synthesis complete. Output saved to {args.output}')
            else:
                print(f'[Text2Wave] Error: {response.text}')
